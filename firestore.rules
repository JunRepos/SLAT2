rules_version = '2';

// SLAT 기록장 보안 규칙
//  - 교사: Firebase Authentication 이메일/비밀번호 계정 (아래 목록의 이메일만)
//  - 학생: 익명 로그인 후 links/{uid} 에 학번·이름을 기록하면, 규칙이 roster/{학번}과 대조해 그 팀 권한만 준다.
//    (접속코드 없이 학번+이름으로 들어오므로, 이름을 아는 사람은 대신 들어올 수 있다.)
//
// 컬렉션
//  teams/{teamId}              계획서 (교사만 쓰기, 팀원 읽기)
//  teams/{teamId}/logs/{no}    차시 기록 (팀원 작성, 교사 검토·직접 작성)
//  teams/{teamId}/attendance/{no}  교사 출결 체크 (팀원 읽기)
//  teams/{teamId}/reports/{sid}  개인별 최종 보고서 (본인 작성, 교사 확인)
//  teams/{teamId}/poster/{part}  팀 포스터의 글(main)과 사진(photo-*) (팀원 작성)
//  (구매 내역은 teams/{teamId} 문서의 purchases 필드 — 교사만 쓰기)
//  roster/{sid}                학번 → {name, teamId} (교사만 쓰기, 본인 읽기)
//  links/{uid}                 로그인한 학생 기기 → {sid, name, at}

service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ 담당 교사 로그인 이메일로 바꾸세요. 여러 명이면 쉼표로 추가.
    function isTeacher() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['chlwns1023@gmail.com'];
    }

    function hasLink() {
      return request.auth != null
        && exists(/databases/$(database)/documents/links/$(request.auth.uid));
    }
    function link() {
      return get(/databases/$(database)/documents/links/$(request.auth.uid)).data;
    }
    // 명단(roster)의 학번·이름과 맞아야 유효한 로그인.
    // 교사가 이름을 고치거나 명단에서 빼면 그 학생의 기존 로그인은 즉시 무효가 된다.
    function validLink() {
      return hasLink()
        && get(/databases/$(database)/documents/roster/$(link().sid)).data.name == link().name;
    }
    function self() {
      return get(/databases/$(database)/documents/roster/$(link().sid)).data;
    }
    function isMember(teamId) {
      return validLink() && self().teamId == teamId;
    }

    function studentKeys() {
      return ['content', 'results', 'issues', 'nextPlan', 'references', 'attendance', 'contributions',
              'status', 'rev', 'updatedAt', 'updatedBy', 'submittedAt', 'history'];
    }
    function text(d, k) {
      return d.get(k, '') is string && d.get(k, '').size() <= 5000;
    }
    function studentLogOk(teamId, d) {
      return isMember(teamId)
        && d.updatedBy == link().sid + ' ' + self().name
        && text(d, 'content') && text(d, 'results') && text(d, 'issues')
        && text(d, 'nextPlan') && text(d, 'references')
        && d.attendance is list && d.attendance.size() <= 20
        && d.contributions is map
        && d.history is list && d.history.size() <= 30;
    }

    // 개인별 최종 보고서 (본인만 작성, 교사 확인)
    function reportKeys() {
      return ['title', 'goal', 'motive', 'activity', 'sources', 'difficulty', 'teamwork', 'insight', 'poster', 'future',
              'status', 'updatedAt', 'submittedAt'];
    }
    function rtext(d, k) {
      return d.get(k, '') is string && d.get(k, '').size() <= 3000;
    }
    function reportOk(teamId, sid, d) {
      return isMember(teamId) && link().sid == sid
        && rtext(d, 'title') && rtext(d, 'goal')
        && rtext(d, 'motive') && rtext(d, 'activity') && rtext(d, 'sources') && rtext(d, 'difficulty') && rtext(d, 'teamwork')
        && rtext(d, 'insight') && rtext(d, 'poster') && rtext(d, 'future');
    }

    // 팀 포스터: 글은 poster/main, 사진은 poster/photo-{구역} (줄인 JPEG data URL)
    function ptext(d, k, n) {
      return d.get(k, '') is string && d.get(k, '').size() <= n;
    }
    function posterMainOk(d) {
      return d.keys().hasOnly(['title', 'sub', 'affil', 'abstract', 'theme', 'layout', 'sources', 'updatedAt', 'updatedBy',
          't_motive', 't_theory', 't_method', 't_result', 't_conclusion', 't_difficulty', 't_insight',
          'c_theory', 'c_method', 'c_result', 'c_resultb'])
        && ptext(d, 'title', 100) && ptext(d, 'sub', 200) && ptext(d, 'affil', 100) && ptext(d, 'abstract', 800)
        && ptext(d, 'theme', 20) && ptext(d, 'layout', 20)
        && ptext(d, 'sources', 600) && ptext(d, 'updatedAt', 40) && ptext(d, 'updatedBy', 60)
        && ptext(d, 't_motive', 2000) && ptext(d, 't_theory', 2000) && ptext(d, 't_method', 2000)
        && ptext(d, 't_result', 2000) && ptext(d, 't_conclusion', 2000)
        && ptext(d, 't_difficulty', 2000) && ptext(d, 't_insight', 2000)
        && ptext(d, 'c_theory', 100) && ptext(d, 'c_method', 100) && ptext(d, 'c_result', 100) && ptext(d, 'c_resultb', 100);
    }
    function posterPhotoOk(d) {
      return d.keys().hasOnly(['data', 'updatedAt'])
        && d.data is string && d.data.size() < 950000
        && d.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && ptext(d, 'updatedAt', 40);
    }

    match /links/{uid} {
      allow read, delete: if request.auth != null && (request.auth.uid == uid || isTeacher());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sid', 'name', 'at'])
        && request.resource.data.sid is string
        && get(/databases/$(database)/documents/roster/$(request.resource.data.sid)).data.name == request.resource.data.name;
    }

    match /roster/{sid} {
      allow read: if isTeacher() || (validLink() && link().sid == sid);
      allow write: if isTeacher();
    }

    match /teams/{teamId} {
      allow read: if isTeacher() || isMember(teamId);
      allow write: if isTeacher();

      // 교사가 체크하는 출결 {marks: {학번: '출석'|...}, notes, updatedAt}
      match /attendance/{no} {
        allow read: if isTeacher() || isMember(teamId);
        allow write: if isTeacher();
      }

      // 개인별 최종 보고서: 본인과 교사만 읽는다. 교사가 확인 완료(approved)하면 학생 수정이 잠긴다.
      match /reports/{sid} {
        allow read: if isTeacher() || (isMember(teamId) && link().sid == sid);
        allow delete: if isTeacher();
        allow create: if isTeacher() || (
          reportOk(teamId, sid, request.resource.data)
          && request.resource.data.keys().hasOnly(reportKeys())
          && request.resource.data.status in ['draft', 'submitted']
        );
        allow update: if isTeacher() || (
          reportOk(teamId, sid, request.resource.data)
          && resource.data.status != 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(reportKeys())
          && (request.resource.data.status in ['draft', 'submitted']
              || request.resource.data.status == resource.data.status)
        );
      }

      // 팀 포스터: 팀원 누구나 고친다.
      match /poster/{part} {
        allow read: if isTeacher() || isMember(teamId);
        allow delete: if isTeacher() || (isMember(teamId) && part.matches('photo-[a-z]+'));
        allow create, update: if isTeacher() || (isMember(teamId) && (
          (part == 'main' && posterMainOk(request.resource.data))
          || (part.matches('photo-[a-z]+') && posterPhotoOk(request.resource.data))
        ));
      }

      match /logs/{no} {
        allow read: if isTeacher() || isMember(teamId);
        allow delete: if isTeacher();
        allow create: if isTeacher() || (
          studentLogOk(teamId, request.resource.data)
          && request.resource.data.keys().hasOnly(studentKeys())
          && request.resource.data.status in ['draft', 'submitted']
          && request.resource.data.rev == 1
        );
        allow update: if isTeacher() || (
          studentLogOk(teamId, request.resource.data)
          && resource.data.status != 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(studentKeys())
          && (request.resource.data.status in ['draft', 'submitted']
              || request.resource.data.status == resource.data.status)
          && request.resource.data.rev == resource.data.rev + 1
        );
      }
    }

  }
}
